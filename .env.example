MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pgfinder

# Google AI Studio key (used for embeddings only)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Cloudinary: create an UNSIGNED upload preset in the Cloudinary dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET=

# Google sign-in (Auth.js). Generate AUTH_SECRET with:  npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed when hosting somewhere other than Vercel:
AUTH_TRUST_HOST=true
